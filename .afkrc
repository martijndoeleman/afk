# .afkrc — afk settings for this repository. Written by `afk.sh init`.
#
# Commit it: it is what makes `afk loop` do the right thing here without
# being told. Environment variables still win over anything set below, and
# every commented-out line is showing you afk's built-in default.

# --- sandbox ---
# sandbox name. One per repository — the default is this directory's name
BOX=afk
# claude or codex (see AGENT PROFILES)
# AGENT=claude
# 1 = private in-VM clone, 0 = mount your working tree directly
# USE_CLONE=1
# branch the agent commits to
# BRANCH=afk-agent
# 0 = auto (all host CPUs)
# CPUS=0
# e.g. 8g; empty = the sbx default
# MEMORY=""

# --- loop control ---
# hard cap on iterations; always set one
# MAX_ITERATIONS=10
# agentic turns per iteration (claude only)
# MAX_TURNS=40
# seconds between iterations
# SLEEP_BETWEEN=0
# bail if an iteration commits nothing
# STOP_ON_NO_COMMIT=1

# --- the prompt ---
# the only input to `loop` — it is the prompt
# PROMPT_FILE=PROMPT.md
# what the agent says when the list is finished
# DONE_SENTINEL=ALL_DONE
# empty = the agent profile's default (claude: opus)
# MODEL=""
# low, medium, high, xhigh or max; empty = the agent's default
# EFFORT=medium

# --- output ---
# per-iteration JSON, and any bundle a failed fetch leaves
# LOG_DIR=./.afk-logs
